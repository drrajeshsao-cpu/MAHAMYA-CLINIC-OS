rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isClinicAdmin(){ return request.auth != null && request.auth.token.email == "ADMIN_EMAIL_HERE"; }
    match /clinicOS_data/{document=**} { allow read, write: if isClinicAdmin(); }
    match /{document=**} { allow read, write: if false; }
  }
}
